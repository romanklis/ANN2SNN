# The build container's $HOME is not always writable, which makes npm's default
# cache location (~/.npm) fail with ENOENT; /tmp is also a small 100 MB tmpfs.
# Pin the cache onto the roomy workspace volume so `npm ci` / `npm install`
# work out of the box in the ann2snn image.
cache=/workspace/.cache/npm
fund=false
audit=false
